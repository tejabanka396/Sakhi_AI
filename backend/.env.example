# ==============================================================================
# Sakhi AI — Backend Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (MySQL 8.0 utf8mb4)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sakhi_ai?charset=utf8mb4

# Security / Authentication
JWT_SECRET=sakhi_ai_super_secret_jwt_key_please_change_in_production_32chars_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Voice / TTS / STT Configuration (Edge-TTS Neural)
EDGE_TTS_VOICE_FEMALE=te-IN-ShrutiNeural
EDGE_TTS_VOICE_MALE=te-IN-MohanNeural
EDGE_TTS_VOICE_EN_FEMALE=en-IN-NeerjaNeural
EDGE_TTS_VOICE_EN_MALE=en-IN-PrabhatNeural

# ==============================================================================
# Real MSG91 SMS Gateway Configuration (India DLT Compliant)
# ==============================================================================
# Provider selection: 'dev' (local development - logs OTP to terminal), 'msg91' (production real SMS), 'twilio', or 'mock'
SMS_PROVIDER=dev

# MSG91 Auth Key:
# Found in: MSG91 Dashboard -> Authkey (or Top Right Profile -> API / Authkey)
MSG91_AUTH_KEY=your_msg91_auth_key_here

# MSG91 OTP Template ID:
# Found in: MSG91 Dashboard -> OTP -> Templates -> Template ID
# Ensure the DLT approved template includes ##OTP## placeholder or variable
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here

# MSG91 Sender ID / Header:
# Found in: MSG91 Dashboard -> SMS -> Sender Id (Approved 6-character DLT Header, e.g., SAKHIA)
MSG91_SENDER_ID=SAKHIA

# Optional Twilio Provider Configuration (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890

# OTP Security and Expiry Settings
OTP_RATE_LIMIT_SECONDS=60
OTP_EXPIRE_MINUTES=5
